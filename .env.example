# HealthMate AI Configuration
# Copy this file to .env and configure your keys if you want live AI connectivity.
# If no key is set, HealthMate AI runs in "Safe Offline Mode" using its built-in medical dictionary.

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key-for-sessions

# Optional: Google Gemini API Key for live AI responses
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
